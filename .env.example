# ============ СЕКРЕТЫ (генерируются install.sh автоматически) ============
# Токен доступа к MCP (Bearer) — для подключения MCP-клиента
MCP_TOKEN=

# Секрет подписи сессий панели (HMAC). Смена разлогинит всех пользователей.
SESSION_SECRET=

# ============ ВХОД В ПАНЕЛЬ (Telegram OpenID Connect) ============
# Client ID и Client Secret OIDC-приложения из @BotFather.
# Открой мини-приложение @BotFather (кнопка «Open» в чате с ним) ->
# Bot Settings -> Web Login. В Allowed URLs добавь ОБА адреса:
#   https://DOMAIN   и   https://DOMAIN/auth/callback
# Client ID и Client Secret показаны там же — бери их именно оттуда,
# это НЕ токен бота (токен идёт в TG_BOT_TOKEN).
TG_CLIENT_ID=
TG_CLIENT_SECRET=

# Telegram ID пользователей, которым разрешён вход в панель (через запятую).
# Свой ID узнай у бота @userinfobot. ID отклонённых попыток входа видны
# в логах панели: docker compose logs dashboard
ALLOWED_TG_USERS=

# ============ БЭКАПЫ В TELEGRAM ============
# Токен бота (от @BotFather), который будет присылать архивы бэкапов.
# Можно использовать того же бота, что и для входа в панель.
TG_BOT_TOKEN=

# ID чата, куда слать бэкапы: твой личный ID — бот пришлёт архив в личку
# (бота нужно один раз запустить кнопкой Start), либо ID группы.
TG_CHAT_ID=

# Как часто делать бэкап (в часах) и сколько архивов хранить локально
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# Необязательно: через сколько часов без успешной копии отправить одно
# предупреждение в Telegram. Пусто = автоматически max(2 интервала, интервал + 1 час).
BACKUP_STALE_AFTER_HOURS=

# Необязательно: пароль для шифрования архивов бэкапов (AES-256, openssl).
# Если задан — в Telegram и в папку backups попадают зашифрованные файлы .enc.
# Расшифровка: openssl enc -d -aes-256-cbc -pbkdf2 -in файл.enc -out файл.tar.gz
BACKUP_PASSWORD=

# Автоматически расшифровать и распаковать каждый новый архив во временную папку.
BACKUP_RESTORE_DRILL=true

# Мониторинг панели и Telegram alerts.
MONITOR_INTERVAL_SECONDS=60
MONITOR_BACKUP_HEARTBEAT_SECONDS=180
MONITOR_S3_PENDING_LIMIT=100
MONITOR_DISK_FREE_PERCENT=10


# ============ ПОСТОЯННОЕ S3-ХРАНИЛИЩЕ (ОПЦИОНАЛЬНО) ============
# false = прежний локальный режим: PROJECTS_DIR является постоянным хранилищем.
# true = /data остаётся локальной рабочей копией, изменения сохраняются в S3.
S3_ENABLED=false

# Возьми S3 API Endpoint и пару ключей в панели Рег.облака: Хранилище S3 -> Ключи доступа.
# Для Reg.Ru обычно используется https://s3.regru.cloud, но копируй актуальный endpoint из панели.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# Непустой prefix внутри одного bucket. Отдельные bucket на проекты не создаются.
S3_PREFIX=projects/

# Дополнительные исключения через запятую. Встроенно всегда исключаются:
# node_modules, .git, .cache, tmp, __pycache__, *.pyc, *.log и служебные триггеры.
S3_EXCLUDE=

# Период полной сверки /data и S3, секунд (минимум 30).
S3_RECONCILE_INTERVAL=600

# ============ ВЕРСИЯ ОБРАЗОВ ============
# latest — обычное обновление. Для отката укажи опубликованный релиз,
# например 26.8.1.692, затем docker compose pull && docker compose up -d.
NOVATE_VERSION=latest
NOVATE_DEPLOY_TIMEOUT=600
# Проверять keyless Cosign-подписи образов перед запуском.
NOVATE_VERIFY_SIGNATURES=true

# ============ ОСНОВНЫЕ НАСТРОЙКИ ============
# Домен сервера. Только домен: без https:// и без слэша в конце.
DOMAIN=novate-gpt.space

# Папка проектов на сервере — единственная, к которой имеет доступ MCP.
# Защищённый просмотр через Telegram OIDC: https://DOMAIN/projects/...
# Управление и скачивание: панель на https://DOMAIN/ (вход через Telegram)
# Относительный путь считается от папки mcp-server.
PROJECTS_DIR=./projects

# Часовой пояс внутри контейнеров (время в панели, логи, подписи бэкапов).
# Это переменная окружения рантайма, а не настройка приложения —
# в панели не отображается. После смены: docker compose up -d
TZ=Europe/Moscow
