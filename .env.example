# ============ СЕКРЕТЫ (генерируются install.sh автоматически) ============
# Токен доступа к MCP (Bearer) — для подключения MCP-клиента
MCP_TOKEN=

# Секрет подписи сессий панели (HMAC). Смена разлогинит всех пользователей.
SESSION_SECRET=

# ============ ВХОД В ПАНЕЛЬ (Telegram OpenID Connect) ============
# Client ID и Client Secret OIDC-приложения из @BotFather.
# Открой мини-приложение @BotFather (кнопка «Open» в чате с ним) ->
# Bot Settings -> Web Login. В Allowed URLs добавь ОБА адреса:
#   https://DOMAIN   и   https://DOMAIN/auth/callback
# Client ID и Client Secret показаны там же — бери их именно оттуда,
# это НЕ токен бота (токен идёт в TG_BOT_TOKEN).
TG_CLIENT_ID=
TG_CLIENT_SECRET=

# Telegram ID пользователей, которым разрешён вход в панель (через запятую).
# Свой ID узнай у бота @userinfobot. ID отклонённых попыток входа видны
# в логах панели: docker compose logs dashboard
ALLOWED_TG_USERS=

# ============ БЭКАПЫ В TELEGRAM ============
# Токен бота (от @BotFather), который будет присылать архивы бэкапов.
# Можно использовать того же бота, что и для входа в панель.
TG_BOT_TOKEN=

# ID чата, куда слать бэкапы: твой личный ID — бот пришлёт архив в личку
# (бота нужно один раз запустить кнопкой Start), либо ID группы.
TG_CHAT_ID=

# Как часто делать бэкап (в часах) и сколько архивов хранить локально
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# ============ ОСНОВНЫЕ НАСТРОЙКИ ============
# Домен сервера. Только домен: без https:// и без слэша в конце.
DOMAIN=novate-gpt.space

# Папка проектов на сервере — единственная, к которой имеет доступ MCP.
# Публичный просмотр: https://DOMAIN/projects/...
# Управление и скачивание: панель на https://DOMAIN/ (вход через Telegram)
# Относительный путь считается от папки mcp-server.
PROJECTS_DIR=./projects

# Часовой пояс внутри контейнеров (время в панели, логи, подписи бэкапов).
# Это переменная окружения рантайма, а не настройка приложения —
# в панели не отображается. После смены: docker compose up -d
TZ=Europe/Moscow
